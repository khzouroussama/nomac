Swift's -stack-check (and -no-stack-check), as Xcode 27.0's frontend takes them (ADR 0106, docs/formats/build.md
"Swift stack checks"): with -stack-check, every function IRGen makes, defined or declared, gets
"probe-stack"="__chkstk_darwin" on 64-bit targets; -no-stack-check is accepted and changes nothing. Clang's
own default for the probe (.github/clang 0017) stays out of the attributes Swift's functions start from:
Xcode's Swift functions never have it without -stack-check, and name __chkstk_darwin on x86_64 too.

--- a/include/swift/AST/IRGenOptions.h
+++ b/include/swift/AST/IRGenOptions.h
@@ -372,6 +372,10 @@
   /// objects.
   unsigned EmitStackPromotionChecks : 1;
 
+  /// Whether functions call the platform's stack probe before large stack
+  /// allocations (-stack-check).
+  unsigned EmitStackChecks : 1;
+
   unsigned UseSingleModuleLLVMEmission : 1;
 
   /// Emit functions to separate sections.
@@ -660,7 +664,7 @@
         DebugInfoFormat(IRGenDebugInfoFormat::None),
         DisableClangModuleSkeletonCUs(false), UseJIT(false),
         DisableLLVMOptzns(false), DisableSwiftSpecificLLVMOptzns(false),
-        Playground(false), EmitStackPromotionChecks(false),
+        Playground(false), EmitStackPromotionChecks(false), EmitStackChecks(false),
         UseSingleModuleLLVMEmission(false), FunctionSections(false),
         PrintInlineTree(false), AlwaysCompile(false),
         EmbedMode(IRGenEmbedMode::None), LLVMLTOKind(IRGenLLVMLTOKind::None),
