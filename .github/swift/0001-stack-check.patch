--- a/lib/IRGen/IRGenModule.cpp
+++ b/lib/IRGen/IRGenModule.cpp
@@ -1550,6 +1550,12 @@
   // Add the default attributes for the Clang configuration.
   clang::CodeGen::addDefaultFunctionDefinitionAttributes(getClangCGM(), Attrs);
 
+  // Swift functions name Apple's stack probe only with -stack-check, whatever
+  // the Clang configuration's defaults, and on 64-bit targets only.
+  Attrs.removeAttribute("probe-stack");
+  if (IRGen.Opts.EmitStackChecks && Triple.isArch64Bit())
+    Attrs.addAttribute("probe-stack", "__chkstk_darwin");
+
   // Add/remove MinSize based on the appropriate setting.
   if (FuncOptMode == OptimizationMode::NotSet)
     FuncOptMode = IRGen.Opts.OptMode;
