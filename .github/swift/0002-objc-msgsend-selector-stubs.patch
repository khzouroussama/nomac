 /// Get or create an Objective-C selector reference.  Always returns
 /// an i8**.  The design is that the compiler will emit a load of this
 /// pointer, and the linker will ensure that pointer is unique.
+/// The stub through which messages with this selector are sent, which the
+/// linker writes, declared as Xcode 27.0 declares it.
+llvm::Constant *IRGenModule::getObjCMsgSendSelectorStub(StringRef selector) {
+  std::string name = ("objc_msgSend$" + selector).str();
+  if (auto *existing = Module.getFunction(name))
+    return existing;
+  return llvm::Function::Create(llvm::FunctionType::get(VoidTy, false),
+                                llvm::GlobalValue::ExternalLinkage, name,
+                                Module);
+}
+
