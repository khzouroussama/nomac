+// As Xcode 27.0's clang: the unrounded size in x9 for Apple's stack probe,
+// then the rounded size taken from sp.
 SDValue
+AArch64TargetLowering::LowerDarwinDYNAMIC_STACKALLOC(SDValue Op,
+                                                     SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  SDValue Chain = Op.getOperand(0);
+  SDValue Size = Op.getOperand(1);
+  SDValue UnroundedSize = Op.getNumOperands() > 3 ? Op.getOperand(3) : Size;
+  MaybeAlign Align =
+      cast<ConstantSDNode>(Op.getOperand(2))->getMaybeAlignValue();
+  EVT VT = Op.getNode()->getValueType(0);
+
+  Chain = DAG.getCALLSEQ_START(Chain, 0, 0, DL);
+  Chain = DAG.getCopyToReg(Chain, DL, AArch64::X9, UnroundedSize, SDValue());
+  const uint32_t *Mask =
+      Subtarget->getRegisterInfo()->getDarwinStackProbePreservedMask();
+  Chain = SDValue(DAG.getMachineNode(AArch64::StkChkIndirectCall, DL,
+                                     DAG.getVTList(MVT::Other, MVT::Glue),
+                                     {DAG.getRegisterMask(Mask), Chain,
+                                      Chain.getValue(1)}),
+                  0);
+
+  SDValue SP = DAG.getCopyFromReg(Chain, DL, AArch64::SP, MVT::i64);
+  Chain = SP.getValue(1);
+  SP = DAG.getNode(ISD::SUB, DL, MVT::i64, SP, Size);
+  if (Align)
+    SP = DAG.getNode(ISD::AND, DL, VT, SP.getValue(0),
+                     DAG.getSignedConstant(-(uint64_t)Align->value(), DL, VT));
+  Chain = DAG.getCopyToReg(Chain, DL, AArch64::SP, SP);
+
+  Chain = DAG.getCALLSEQ_END(Chain, 0, 0, SDValue(), DL);
+
+  SDValue Ops[2] = {SP, Chain};
+  return DAG.getMergeValues(Ops, DL);
+}
