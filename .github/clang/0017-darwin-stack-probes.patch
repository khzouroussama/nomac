+// Where Xcode 27.0's driver passes -fstack-check unasked: Apple devices from
+// macOS 10.15, iOS and tvOS 13, watchOS 6, Mac Catalyst and visionOS, but not
+// simulators, DriverKit, arm64_32 or -ffreestanding.
+static bool checksStackByDefault(const llvm::Triple &Triple,
+                                 const ArgList &Args) {
+  if (!Triple.isOSDarwin() || Triple.isSimulatorEnvironment() ||
+      Triple.isDriverKit() || Triple.getArch() == llvm::Triple::aarch64_32 ||
+      Args.hasFlag(options::OPT_ffreestanding, options::OPT_fhosted, false))
+    return false;
+  if (Triple.isMacCatalystEnvironment() || Triple.isXROS())
+    return true;
+  if (Triple.isMacOSX())
+    return !Triple.isMacOSXVersionLT(10, 15);
+  if (Triple.isWatchOS())
+    return !Triple.isOSVersionLT(6);
+  return !Triple.isOSVersionLT(13);
+}
