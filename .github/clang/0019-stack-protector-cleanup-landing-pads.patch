+// As Xcode 27.0's clang: one cleanup landing pad for all such calls, which
+// unwinding through the function then runs.
+bool DwarfEHPrepare::addStackProtectorCleanup() {
+  if (!F.hasPersonalityFn() ||
+      isScopedEHPersonality(classifyEHPersonality(F.getPersonalityFn())))
+    return false;
+  DenseMap<const AllocaInst *, MachineFrameInfo::SSPLayoutKind> Layout;
+  if (!StackProtector::requiresStackProtector(&F, &Layout) || Layout.empty())
+    return false;
+
+  SmallPtrSet<BasicBlock *, 32> Reached = {&F.getEntryBlock()};
+  SmallVector<BasicBlock *, 32> Worklist = {&F.getEntryBlock()};
+  while (!Worklist.empty()) {
+    Instruction *Terminator = Worklist.pop_back_val()->getTerminator();
+    if (auto *Invoke = dyn_cast<InvokeInst>(Terminator)) {
+      if (Reached.insert(Invoke->getNormalDest()).second)
+        Worklist.push_back(Invoke->getNormalDest());
+      continue;
+    }
+    for (BasicBlock *Successor : successors(Terminator->getParent()))
+      if (Reached.insert(Successor).second)
+        Worklist.push_back(Successor);
+  }
+
+  SmallVector<CallInst *, 16> Calls;
+  for (BasicBlock &BB : F)
+    if (Reached.contains(&BB))
+      for (Instruction &I : BB)
+        if (auto *Call = dyn_cast<CallInst>(&I))
+          if (!Call->doesNotThrow() && !Call->isInlineAsm() &&
+              !Call->isTailCall() && !isa<IntrinsicInst>(Call))
+            Calls.push_back(Call);
+  if (Calls.empty())
+    return false;
+
+  LLVMContext &Ctx = F.getContext();
+  BasicBlock *Pad = BasicBlock::Create(Ctx, "", &F);
+  auto *LandingPad = LandingPadInst::Create(
+      StructType::get(PointerType::getUnqual(Ctx), Type::getInt32Ty(Ctx)), 0,
+      "", Pad);
+  LandingPad->setCleanup(true);
+  ResumeInst::Create(LandingPad, Pad);
+  for (CallInst *Call : Calls)
+    changeToInvokeAndSplitBasicBlock(Call, Pad, DTU);
+  return true;
+}
+
 bool DwarfEHPrepare::run() {
-  bool Changed = InsertUnwindResumeCalls();
+  bool Changed = addStackProtectorCleanup();
+  Changed |= InsertUnwindResumeCalls();
 
   return Changed;
 }
