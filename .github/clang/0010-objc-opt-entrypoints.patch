+  /// clang calls instead of those messages from macOS 10.15, iOS 13 and watchOS 6?
+  bool shouldUseOptimizedMessageEntrypoints() const {
+    switch (getKind()) {
+    case MacOSX:
+      return getVersion() >= VersionTuple(10, 15);
+    case iOS:
+      return getVersion() >= VersionTuple(13);
+    case WatchOS:
+      return getVersion() >= VersionTuple(6);
+    default:
+      return false;
+    }
+  }
