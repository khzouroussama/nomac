+//===- AArch64ObjCARCRegisterCalls.cpp - objc_retain_x<N>, objc_release_x<N> ----===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Lets the register allocator pick the register in which a call to objc_retain
+// or objc_release takes its object. The Objective-C runtime has entry points
+// that take it in x1 to x15 and x19 to x28 (objc_retain_x<N>, objc_release_x<N>,
+// the retained object returned in x0 as by objc_retain); Xcode 27.0's compilers
+// call them for arm64 targets from iOS, tvOS and Mac Catalyst 16, watchOS 9 and
+// every visionOS, above -O0, and not for macOS. Right after instruction
+// selection, the copy of the object into x0 becomes a copy into a new register
+// and the call OBJC_ARC_CALL_ANYREG, or for a tail call
+// OBJC_ARC_TCRETURN_ANYREG; after register allocation they call the entry point
+// of the allocated register (AArch64ExpandPseudoInsts, and
+// AArch64ObjCARCRegisterTailCalls before the epilogue is inserted). A call to
+// objc_retain keeps the ordinary register mask, not the this-return one, and
+// the uses of its object it dominates take the result copied out of x0, so the
+// object need not live across the call, as in Xcode's code.
+//
+//===----------------------------------------------------------------------===//
+
+#include "AArch64.h"
+#include "AArch64InstrInfo.h"
+#include "AArch64Subtarget.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineDominators.h"
+#include "llvm/CodeGen/MachineFunctionPass.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/IR/GlobalValue.h"
+#include "llvm/InitializePasses.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "aarch64-objc-arc-register-calls"
+
+namespace {
+class AArch64ObjCARCRegisterCalls : public MachineFunctionPass {
+public:
+  static char ID;
+  AArch64ObjCARCRegisterCalls() : MachineFunctionPass(ID) {
+    initializeAArch64ObjCARCRegisterCallsPass(*PassRegistry::getPassRegistry());
+  }
+  bool runOnMachineFunction(MachineFunction &MF) override;
+  StringRef getPassName() const override {
+    return "AArch64 Objective-C ARC register entry points";
+  }
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesCFG();
+    AU.addRequired<MachineDominatorTreeWrapperPass>();
+    AU.addPreserved<MachineDominatorTreeWrapperPass>();
+    MachineFunctionPass::getAnalysisUsage(AU);
+  }
+};
+
+class AArch64ObjCARCRegisterTailCalls : public MachineFunctionPass {
+public:
+  static char ID;
+  AArch64ObjCARCRegisterTailCalls() : MachineFunctionPass(ID) {
+    initializeAArch64ObjCARCRegisterTailCallsPass(
+        *PassRegistry::getPassRegistry());
+  }
+  bool runOnMachineFunction(MachineFunction &MF) override;
+  StringRef getPassName() const override {
+    return "AArch64 Objective-C ARC register entry point tail calls";
+  }
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesCFG();
+    MachineFunctionPass::getAnalysisUsage(AU);
+  }
+};
+} // end anonymous namespace
+
+char AArch64ObjCARCRegisterCalls::ID = 0;
+char AArch64ObjCARCRegisterTailCalls::ID = 0;
+
+INITIALIZE_PASS_BEGIN(AArch64ObjCARCRegisterCalls, DEBUG_TYPE,
+                      "AArch64 Objective-C ARC register entry points", false,
+                      false)
+INITIALIZE_PASS_DEPENDENCY(MachineDominatorTreeWrapperPass)
+INITIALIZE_PASS_END(AArch64ObjCARCRegisterCalls, DEBUG_TYPE,
+                    "AArch64 Objective-C ARC register entry points", false,
+                    false)
+INITIALIZE_PASS(AArch64ObjCARCRegisterTailCalls,
+                "aarch64-objc-arc-register-tail-calls",
+                "AArch64 Objective-C ARC register entry point tail calls",
+                false, false)
+
+static bool hasRegisterEntryPoints(const Triple &T) {
+  if (!T.isAArch64() || !T.isOSDarwin() || T.isMacOSX())
+    return false;
+  if (T.isXROS())
+    return true;
+  if (T.isWatchOS())
+    return T.getOSVersion() >= VersionTuple(9);
+  if (T.isiOS())
+    return T.getOSVersion() >= VersionTuple(16);
+  return false;
+}
+
+/// 0 for objc_retain, 1 for objc_release, -1 for any other instruction.
+static int64_t entryPointKind(const MachineInstr &MI) {
+  if ((MI.getOpcode() != AArch64::BL && MI.getOpcode() != AArch64::TCRETURNdi) ||
+      !MI.getOperand(0).isGlobal())
+    return -1;
+  StringRef Name = MI.getOperand(0).getGlobal()->getName();
+  if (Name == "objc_retain")
+    return 0;
+  if (Name == "objc_release")
+    return 1;
+  return -1;
+}
+
+/// The copy of the call's object into x0, when nothing between it and the
+/// call reads or writes x0.
+static MachineInstr *argumentCopy(MachineInstr &Call,
+                                  const TargetRegisterInfo *TRI) {
+  for (MachineInstr &MI : make_range(std::next(Call.getReverseIterator()),
+                                     Call.getParent()->instr_rend())) {
+    if (MI.isCall())
+      return nullptr;
+    if (MI.isCopy() && MI.getOperand(0).getReg() == AArch64::X0 &&
+        MI.getOperand(1).getReg().isVirtual() && !MI.getOperand(1).getSubReg())
+      return &MI;
+    if (MI.readsRegister(AArch64::X0, TRI) ||
+        MI.modifiesRegister(AArch64::X0, TRI))
+      return nullptr;
+  }
+  return nullptr;
+}
+
+/// Whether Def dominates Use: Use is later in Def's block, or in a block Def's
+/// dominates (for a PHI, the block the value comes from).
+static bool dominatesUse(const MachineInstr &Def, const MachineOperand &Use,
+                         const MachineDominatorTree &DT) {
+  const MachineInstr &User = *Use.getParent();
+  const MachineBasicBlock *Block = Def.getParent();
+  const MachineBasicBlock *UseBlock = User.getParent();
+  if (User.isPHI()) {
+    UseBlock = User.getOperand(Use.getOperandNo() + 1).getMBB();
+    return UseBlock == Block || DT.dominates(Block, UseBlock);
+  }
+  if (UseBlock != Block)
+    return DT.dominates(Block, UseBlock);
+  for (const MachineInstr &MI :
+       make_range(std::next(Def.getIterator()), Block->instr_end()))
+    if (&MI == &User)
+      return true;
+  return false;
+}
+
+/// Copies objc_retain's result out of x0 after the call frame of Call, and
+/// gives it to the uses of Object it dominates.
+static void useRetainResult(MachineInstr &Call, Register Object,
+                            const TargetInstrInfo *TII, MachineRegisterInfo &MRI,
+                            const MachineDominatorTree &DT) {
+  MachineBasicBlock &MBB = *Call.getParent();
+  MachineBasicBlock::iterator After = std::next(Call.getIterator());
+  if (After != MBB.end() &&
+      After->getOpcode() == TII->getCallFrameDestroyOpcode())
+    ++After;
+  Register Result = MRI.createVirtualRegister(&AArch64::GPR64allRegClass);
+  MachineInstr &Copy =
+      *BuildMI(MBB, After, Call.getDebugLoc(), TII->get(TargetOpcode::COPY),
+               Result)
+           .addReg(AArch64::X0);
+  const TargetRegisterClass *ObjectRC = MRI.getRegClass(Object);
+  for (MachineOperand &Use :
+       make_early_inc_range(MRI.use_nodbg_operands(Object))) {
+    if (!dominatesUse(Copy, Use, DT) || !MRI.constrainRegClass(Result, ObjectRC))
+      continue;
+    Use.setReg(Result);
+    Use.setIsKill(false);
+  }
+}
+
+bool AArch64ObjCARCRegisterCalls::runOnMachineFunction(MachineFunction &MF) {
+  const auto &ST = MF.getSubtarget<AArch64Subtarget>();
+  if (skipFunction(MF.getFunction()) ||
+      !hasRegisterEntryPoints(ST.getTargetTriple()))
+    return false;
+  const TargetInstrInfo *TII = ST.getInstrInfo();
+  const TargetRegisterInfo *TRI = ST.getRegisterInfo();
+  MachineRegisterInfo &MRI = MF.getRegInfo();
+  const MachineDominatorTree &DT =
+      getAnalysis<MachineDominatorTreeWrapperPass>().getDomTree();
+  const uint32_t *CallMask =
+      TRI->getCallPreservedMask(MF, MF.getFunction().getCallingConv());
+  bool Changed = false;
+  for (MachineBasicBlock &MBB : MF) {
+    for (MachineInstr &MI : make_early_inc_range(MBB)) {
+      int64_t Kind = entryPointKind(MI);
+      if (Kind < 0)
+        continue;
+      MachineInstr *Copy = argumentCopy(MI, TRI);
+      if (!Copy)
+        continue;
+      bool TailCall = MI.getOpcode() == AArch64::TCRETURNdi;
+      Register Original = Copy->getOperand(1).getReg();
+      Register Object = MRI.createVirtualRegister(
+          TailCall ? &AArch64::GPR64objctailRegClass
+                   : &AArch64::GPR64objcargRegClass);
+      BuildMI(MBB, *Copy, Copy->getDebugLoc(), TII->get(TargetOpcode::COPY),
+              Object)
+          .addReg(Original);
+      // The call's own implicit operands come from MI, as the BL's did.
+      MachineInstr *NewMI = MF.CreateMachineInstr(
+          TII->get(TailCall ? AArch64::OBJC_ARC_TCRETURN_ANYREG
+                            : AArch64::OBJC_ARC_CALL_ANYREG),
+          MI.getDebugLoc(), /*NoImplicit=*/true);
+      MBB.insert(MI.getIterator(), NewMI);
+      MachineInstrBuilder Call(MF, NewMI);
+      Call.addImm(Kind).addReg(Object);
+      bool Retain = Kind == 0 && !TailCall;
+      bool DefinesX0 = false;
+      for (const MachineOperand &MO : drop_begin(MI.operands())) {
+        if (MO.isReg() && MO.isImplicit() && MO.getReg() == AArch64::X0) {
+          if (MO.isUse())
+            continue;
+          DefinesX0 = true;
+        }
+        if (Retain && MO.isRegMask())
+          Call.addRegMask(CallMask);
+        else
+          Call.add(MO);
+      }
+      // A this-return call preserved x0; the result now comes back in it.
+      if (Retain && !DefinesX0)
+        Call.addReg(AArch64::X0, RegState::ImplicitDefine);
+      if (MI.shouldUpdateAdditionalCallInfo())
+        MF.moveAdditionalCallInfo(&MI, Call.getInstr());
+      MI.eraseFromParent();
+      Copy->eraseFromParent();
+      Changed = true;
+      if (Retain)
+        useRetainResult(*NewMI, Original, TII, MRI, DT);
+    }
+  }
+  return Changed;
+}
+
+bool AArch64ObjCARCRegisterTailCalls::runOnMachineFunction(
+    MachineFunction &MF) {
+  const TargetInstrInfo *TII = MF.getSubtarget().getInstrInfo();
+  const TargetRegisterInfo *TRI = MF.getSubtarget().getRegisterInfo();
+  bool Changed = false;
+  for (MachineBasicBlock &MBB : MF) {
+    for (MachineInstr &MI : make_early_inc_range(MBB.terminators())) {
+      if (MI.getOpcode() != AArch64::OBJC_ARC_TCRETURN_ANYREG)
+        continue;
+      Register Object = MI.getOperand(1).getReg();
+      std::string Name =
+          MI.getOperand(0).getImm() == 0 ? "objc_retain" : "objc_release";
+      if (Object != AArch64::X0)
+        Name += "_x" + utostr(TRI->getEncodingValue(Object));
+      MachineInstrBuilder Return =
+          BuildMI(MBB, MI, MI.getDebugLoc(), TII->get(AArch64::TCRETURNdi))
+              .addExternalSymbol(MF.createExternalSymbolName(Name));
+      for (const MachineOperand &MO : drop_begin(MI.operands(), 2))
+        Return.add(MO);
+      Return.addReg(Object, RegState::Implicit);
+      if (MI.shouldUpdateAdditionalCallInfo())
+        MF.moveAdditionalCallInfo(&MI, Return.getInstr());
+      MI.eraseFromParent();
+      Changed = true;
+    }
+  }
+  return Changed;
+}
+
+FunctionPass *llvm::createAArch64ObjCARCRegisterCallsPass() {
+  return new AArch64ObjCARCRegisterCalls();
+}
+
+FunctionPass *llvm::createAArch64ObjCARCRegisterTailCallsPass() {
+  return new AArch64ObjCARCRegisterTailCalls();
+}
