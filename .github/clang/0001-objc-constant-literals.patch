+@interface NSDictionary<KeyType, ObjectType> : NSObject
++ dictionaryWithObjects:(ObjectType[_Nullable])objects
+                forKeys:(KeyType[_Nullable])keys
+                  count:(NSUInteger)cnt;
+@end
