+// Xcode's ld orders the GOT by the slots' ordinals read as unsigned: the
+// image's own symbols, each dylib's in turn, the weak definitions (bound or
+// not), then the flat lookups; and by name within each.
+static uint16_t gotOrder(const Symbol &sym) {
+  if (sym.isWeakDef())
+    return static_cast<uint16_t>(BIND_SPECIAL_DYLIB_WEAK_LOOKUP);
+  if (needsBinding(&sym))
+    return static_cast<uint16_t>(ordinalForSymbol(sym));
+  return 0;
 }
 
+void NonLazyPointerSectionBase::finalizeEntries(bool inXcodeOrder) {
+  if (inXcodeOrder) {
+    std::vector<const Symbol *> sorted(entries.begin(), entries.end());
+    llvm::stable_sort(sorted, [](const Symbol *a, const Symbol *b) {
+      return std::make_pair(gotOrder(*a), a->getName()) <
+             std::make_pair(gotOrder(*b), b->getName());
+    });
+    entries.clear();
+    entries.insert(sorted.begin(), sorted.end());
+  }
+  for (const auto &[i, sym] : llvm::enumerate(entries)) {
+    const_cast<Symbol *>(sym)->gotIndex = i;
+    addNonLazyBindingEntries(sym, isec, i * target->wordSize);
+  }
+}
