+// The files in the order Xcode 27.0's ld lays out their sections: in the order
+// of the command line, the members of an archive at the archive's place, in
+// the archive's order, whatever order they were loaded in.
+static std::vector<const InputFile *> filesInLayoutOrder() {
+  DenseMap<const InputFile *, size_t> position;
+  for (const InputFile *file : inputFiles)
+    position.try_emplace(file, position.size());
+  std::vector<const InputFile *> files(inputFiles.begin(), inputFiles.end());
+  auto key = [&](const InputFile *file) {
+    if (file->archive && position.count(file->archive))
+      return std::make_tuple(position[file->archive], true, file->archiveOffset);
+    return std::make_tuple(position[file], false, uint64_t(0));
+  };
+  llvm::stable_sort(files, [&](const InputFile *a, const InputFile *b) {
+    return key(a) < key(b);
+  });
+  return files;
+}
