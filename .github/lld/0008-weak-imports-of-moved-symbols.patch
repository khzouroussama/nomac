diff --git a/lld/MachO/Symbols.h b/lld/MachO/Symbols.h
index beb97b3..16f258c 100644
--- a/lld/MachO/Symbols.h
+++ b/lld/MachO/Symbols.h
@@ -265,10 +265,20 @@ public:
   uint64_t getVA() const override;
   bool isWeakDef() const override { return weakDef; }
 
-  // Symbols from weak libraries/frameworks are also weakly-referenced.
+  // Symbols from weak libraries/frameworks are also weakly-referenced, and,
+  // as with Xcode's ld, the symbols $ld$previous moved out of a weakly linked
+  // dylib.
   bool isWeakRef() const override {
-    return refState == RefState::Weak ||
-           (file && getFile()->umbrella->forceWeakImport);
+    if (refState == RefState::Weak)
+      return true;
+    if (!file)
+      return false;
+    const DylibFile *dylib = getFile();
+    if (dylib->umbrella->forceWeakImport)
+      return true;
+    const DylibFile *origin = dylib->ldPreviousOrigin;
+    return origin && (origin->umbrella->forceWeakImport ||
+                      origin->refState == RefState::Weak);
   }
   bool isReferenced() const { return refState != RefState::Unreferenced; }
   bool isTlv() const override { return tlv; }
