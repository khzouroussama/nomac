 // erase) only some. There will be some categories that will remain untouched
 // (not erased). For these not erased categories, we generate new __objc_catlist
 // entries since the parent __objc_catlist entry will be erased
+void ObjcCategoryMerger::emitListSlot(const InfoWriteSection &listInfo,
+                                      StringRef listName, Defined *entry) {
+  // Allocate data for the new slot
+  llvm::ArrayRef<uint8_t> bodyData = newSectionData(target->wordSize);
+
+  // We mark the slot as belonging to the same file as its entry
+  ObjFile *objFile = dyn_cast<ObjFile>(entry->getFile());
+
+  ConcatInputSection *listSec = make<ConcatInputSection>(
+      *listInfo.inputSection, bodyData, listInfo.align);
+  if (listInfo.outputSection)
+    listSec->parent = listInfo.outputSection;
+  listSec->live = true;
+
+  std::string slotSymName = "<" + listName.str() + " slot for ";
+  slotSymName += entry->getName();
+  slotSymName += ">";
+
+  Defined *slotSym = make<Defined>(
+      newStringData(slotSymName.c_str()), /*file=*/objFile, listSec,
+      /*value=*/0, bodyData.size(),
+      /*isWeakDef=*/false, /*isExternal=*/false, /*isPrivateExtern=*/false,
+      /*includeInSymtab=*/false, /*isReferencedDynamically=*/false,
+      /*noDeadStrip=*/false, /*isWeakDefCanBeHidden=*/false);
+
+  slotSym->used = true;
+  objFile->symbols.push_back(slotSym);
+  addInputSection(listSec);
+
+  // Now link the entry into the newly created slot
+  createSymbolReference(slotSym, entry, 0, listInfo.relocTemplate);
+}
+
+// As Xcode 27.0's ld: a class of the image that a +load category was merged
+// into is listed in __objc_nlclslist, so that the runtime calls its +load.
+void ObjcCategoryMerger::addToNonLazyClassList(
+    const Defined *baseClass, const InfoInputCategory &loadCategory) {
+  ConcatInputSection *nlCatList = loadCategory.nlCatListIsec;
+  auto *section = make<Section>(
+      baseClass->getFile(), segment_names::data,
+      section_names::objcNonLazyClassList, nlCatList->getFlags(), /*addr=*/0);
+  InfoWriteSection listInfo;
+  listInfo.valid = true;
+  listInfo.align = nlCatList->align;
+  listInfo.inputSection = section;
+  listInfo.outputSection = nullptr;
+  for (const Reloc &r : nlCatList->relocs)
+    if (r.offset == loadCategory.offNlCatListIsec)
+      listInfo.relocTemplate = r;
+  emitListSlot(listInfo, section_names::objcNonLazyClassList,
+               const_cast<Defined *>(baseClass));
+}
