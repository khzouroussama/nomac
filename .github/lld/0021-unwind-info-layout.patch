   size_t entryIndex;
   size_t entryCount;
   size_t byteCount;
+  uint64_t offset = 0;
   std::vector<compact_unwind_encoding_t> localEncodings;
   EncodingMap localEncodingIndexes;
+
+  size_t byteSize() const {
+    if (kind == UNWIND_SECOND_LEVEL_COMPRESSED)
+      return sizeof(unwind_info_compressed_second_level_page_header) +
+             (entryCount + localEncodings.size()) * sizeof(uint32_t);
+    return sizeof(unwind_info_regular_second_level_page_header) +
+           entryCount * sizeof(unwind_info_regular_second_level_entry);
+  }
 };
 
