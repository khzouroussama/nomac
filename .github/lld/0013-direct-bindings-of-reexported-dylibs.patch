+bool DylibFile::isAllowedClient() const {
+  if (allowableClients.empty())
+    return true;
+  return !config->clientName.empty() &&
+         llvm::any_of(allowableClients, [](StringRef allowableClient) {
+           return allowableClient.starts_with(config->clientName);
+         });
+}
+
+void DylibFile::bindDirectlyIfAllowed() {
+  if (exportingFile == this || !exportingFile || !isAllowedClient())
+    return;
+  DylibFile *previous = exportingFile;
+  exportingFile = this;
+  for (Symbol *sym : symbols)
+    if (auto *dysym = dyn_cast_or_null<DylibSymbol>(sym))
+      if (dysym->getFile() == previous)
+        dysym->setFile(this);
 }
 
