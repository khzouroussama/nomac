+void SymbolTable::fetchPendingArchiveMembers() {
+  while (!pendingArchiveFetches.empty()) {
+    std::vector<Symbol *> round = std::move(pendingArchiveFetches);
+    pendingArchiveFetches.clear();
+    llvm::sort(round, [](const Symbol *a, const Symbol *b) {
+      return a->getName() < b->getName();
+    });
+    round.erase(std::unique(round.begin(), round.end()), round.end());
+    for (Symbol *s : round)
+      if (auto *lazy = dyn_cast<LazyArchive>(s))
+        lazy->fetchArchiveMember();
+  }
+  deferArchiveFetches = false;
+}
