 void OutputSegment::sortOutputSections() {
   // Must be stable_sort() to keep special sections such as
   // S_THREAD_LOCAL_REGULAR in input order.
-  llvm::stable_sort(sections, compareByOrder<OutputSection *>(sectionOrder));
+  // The sections created for section$start and section$end symbols, which
+  // share one order, go in name order, as Xcode 27.0's ld writes them.
+  llvm::stable_sort(sections, [](OutputSection *a, OutputSection *b) {
+    int orderA = sectionOrder(a);
+    int orderB = sectionOrder(b);
+    if (orderA != orderB)
+      return orderA < orderB;
+    return orderA == UnspecifiedInputOrder && a->name < b->name;
+  });
 }
 
