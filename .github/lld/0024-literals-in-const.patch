+      // Xcode 27.0's ld writes the literals into __TEXT,__const in input order,
+      // each at its first occurrence: one subsection per literal, which
+      // foldIdenticalLiterals() folds into the first equal one.
+      uint32_t literalSize = 1 << (sectionType(sec.flags) == S_4BYTE_LITERALS
+                                       ? 2
+                                   : sectionType(sec.flags) == S_8BYTE_LITERALS
+                                       ? 3
+                                       : 4);
+      Section &literals = *make<Section>(
+          this, segname, section_names::const_,
+          S_REGULAR | (sec.flags & SECTION_ATTRIBUTES), sec.addr);
+      literals.isWordLiterals = true;
+      for (uint64_t off = 0; off < data.size(); off += literalSize)
+        section.subsections.push_back(
+            {off, make<ConcatInputSection>(literals,
+                                           data.slice(off, literalSize),
+                                           std::min(align, literalSize))});
+      section.doneSplitting = true;
