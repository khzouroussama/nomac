diff --git a/Sources/SwiftDriver/Utilities/Triple+Platforms.swift b/Sources/SwiftDriver/Utilities/Triple+Platforms.swift
index 94a9dc87..fe7420d7 100644
--- a/Sources/SwiftDriver/Utilities/Triple+Platforms.swift
+++ b/Sources/SwiftDriver/Utilities/Triple+Platforms.swift
@@ -525,3 +525,28 @@ extension Triple.FeatureAvailability {
   // - Make assigning 'nil' to an NSMutableDictionary subscript delete the
   //   entry, like it does for Swift.Dictionary, rather than trap.
 }
+
+extension Triple.FeatureAvailability {
+  /// Code compiled for these triples calls `__chkstk_darwin` before large
+  /// stack allocations when `-stack-check` is passed to the frontend.
+  static let stackCheck = Self(
+    macOS: .available(since: Triple.Version(10, 15, 0)),
+    iOS: .available(since: Triple.Version(13, 0, 0)),
+    tvOS: .available(since: Triple.Version(13, 0, 0)),
+    watchOS: .available(since: Triple.Version(6, 0, 0))
+  ).withVisionOS(.availableInAllVersions)
+}
+
+extension Triple {
+  /// Whether the driver passes `-stack-check` to the frontend when neither
+  /// `-stack-check` nor `-no-stack-check` is given: never for the iOS, tvOS
+  /// and watchOS simulators, nor for arm64_32.
+  var checksStackByDefault: Bool {
+    switch darwinPlatform {
+    case .iOS(.simulator), .tvOS(.simulator), .watchOS(.simulator):
+      return false
+    default:
+      return arch != .aarch64_32 && supports(.stackCheck)
+    }
+  }
+}
